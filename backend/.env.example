# Midiforja Configuration
# Copy to .env and adjust as needed

# MidiMate location
MIDIFORJA_MIDIMATE_DIR=F:\ia.proyectos\MidiMate
MIDIFORJA_MIDIMATE_URL=http://localhost:5173

# Server
MIDIFORJA_HOST=127.0.0.1
MIDIFORJA_PORT=8000

# Audiveris (optional OMR)
# MIDIFORJA_AUDIVERIS_BIN=C:\Program Files\Audiveris\bin\audiveris.bat
# MIDIFORJA_OMR_TIMEOUT=180
