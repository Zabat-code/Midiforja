# Midiforja Configuration
# Copia este archivo a backend/.env y ajusta. También puedes exportar las
# variables directamente en la shell. Requiere python-dotenv para el archivo.

# Servidor
MIDIFORJA_HOST=127.0.0.1
MIDIFORJA_PORT=8000

# Rate limit: peticiones /api/* por minuto y por IP (0 = sin límite práctico)
MIDIFORJA_RATE_LIMIT_MAX=30

# Base de datos local de packs de estudio (SQLite)
# Por defecto: <repo>/backend/data/midiforja.db
# MIDIFORJA_DB_PATH=/ruta/a/midiforja.db

# Orígenes CORS adicionales (separados por coma), p.ej. el frontend de Vite.
# Ya se permiten 5173/5174/5175, 8000, 8765 y "null" (MidiMate Electron).
# MIDIFORJA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8765

# WebSocket (hub compartido con el endpoint /api/midimate/ws)
# MIDIFORJA_WS_HEARTBEAT_INTERVAL=10
# MIDIFORJA_WS_HEARTBEAT_TIMEOUT=30

# MidiMate location (solo para el botón opcional "Abrir en MidiMate")
# En Linux/macOS usa rutas POSIX; en Windows, C:/Users/<usuario>/... también sirve.
MIDIFORJA_MIDIMATE_DIR=F:\ia.proyectos\MidiMate
MIDIFORJA_MIDIMATE_URL=http://localhost:5173

# Audiveris (OMR opcional). Déjalo vacío para autodetección.
# MIDIFORJA_AUDIVERIS_BIN=C:\Program Files\Audiveris\bin\audiveris.bat
MIDIFORJA_OMR_TIMEOUT=180
